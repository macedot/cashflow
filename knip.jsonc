{
  "$schema": "https://raw.githubusercontent.com/nicepkg/knip/main/knip.schema.json",
  "entry": [
    "src/**/*.js",
    "index.html"
  ],
  "project": [
    "src/**/*.js",
    "*.js"
  ],
  "ignore": [
    "**/*.test.js",
    "vitest.config.js"
  ],
  "ignoreDependencies": [
    "vitest",
    "@vitest/coverage-v8",
    "@eslint/js",
    "eslint-plugin-boundaries"
  ]
}
