# ── Deny everything by default ──
*

# Allow directory traversal (git needs this to descend into subdirs)
!*/

# ── Root config files ──
!.gitignore
!AGENTS.md
!API.md
!README.md
!LICENSE
!.prettierrc
!.jscpd.json
!eslint.config.js
!knip.jsonc
!package.json
!package-lock.json
!playwright.config.js
!release-please-config.json
!tsconfig.json
!vitest.config.js
!index.html

# ── GitHub (CI/CD + repo config) ──
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/CODEOWNERS
!.github/pull_request_template.md

# ── Pre-commit hooks ──
!.husky/
!.husky/pre-commit

# ── Documentation ──
!docs/
!docs/*.md

# ── Source code ──
!src/
!src/*.js
!src/*.css

# ── Static assets ──
!assets/
!assets/*.jpg
!assets/*.jpeg
!assets/*.png
!assets/*.webp

# ── Tests ──
!tests/
!tests/integration/
!tests/integration/*.js

# ── Local skills and agent config ──
!.claude/
!.claude/skills/
!.claude/skills/**

# ── Docker ──
!Dockerfile
!.dockerignore
!docker-compose.yml

# ── Dev container ──
!.devcontainer/
!.devcontainer/**

# ── Re-deny generated / OS artifacts within allowed dirs ──
node_modules/
coverage/
dist/
report/
playwright-report/
test-results/
*.log
.DS_Store
Thumbs.db
.swarm/
